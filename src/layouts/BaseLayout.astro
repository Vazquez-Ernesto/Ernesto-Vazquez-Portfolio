---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: "en" | "es";
}

const {
  title = "Ernesto Vázquez — QA Automation Engineer / SDET · AI Quality Engineering",
  description = "QA Automation Engineer with 5+ years in banking and telecom. Java + Cucumber frameworks for mission-critical systems and LLM agents for QA in production. Founder of QAdvanced.",
  lang = "en",
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Ernesto Vázquez" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-brand-bg text-brand-text font-inter antialiased">
    <slot />
  </body>
</html>
