---
import { getProfile } from '../i18n/content';
import { defaultLocale, type Locale } from '../i18n/locale';
import { ui } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = ui[locale];
const profile = getProfile(locale);

const contactLinks = [
  {
    label: t.contact.labels.email,
    value: profile.email,
    href: `mailto:${profile.email}`,
    icon: "✉",
    external: false,
  },
  {
    label: t.contact.labels.linkedin,
    value: "linkedin.com/in/ernestoavazquez",
    href: "https://www.linkedin.com/in/ernestoavazquez",
    icon: "in",
    external: true,
  },
  {
    label: t.contact.labels.github,
    value: "Vazquez-Ernesto",
    href: "https://github.com/Vazquez-Ernesto",
    icon: "</>",
    external: true,
  },
  {
    label: t.contact.labels.phone,
    value: profile.phone,
    href: `tel:${profile.phone.replace(/\s/g, "")}`,
    icon: "☎",
    external: false,
  },
];
---

<section id="contact" class="py-24 bg-brand-bg">
  <div class="max-w-3xl mx-auto px-6 text-center">
    <!-- Badge -->
    <div class="mb-5">
      <span class="inline-block px-4 py-1.5 rounded-full bg-brand-green/10 text-brand-green text-sm font-medium border border-brand-green/30">
        {t.contact.badge}
      </span>
    </div>

    <h2 class="text-4xl md:text-5xl font-bold text-brand-text mb-5">
      {t.contact.title}
    </h2>
    <p class="text-brand-muted text-lg mb-12 max-w-lg mx-auto leading-relaxed">
      {t.contact.body}
    </p>

    <!-- Contact cards -->
    <div class="grid sm:grid-cols-2 gap-3 mb-12 text-left">
      {contactLinks.map((link) => (
        <a
          href={link.href}
          {...link.external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
          class="flex items-center gap-4 p-4 bg-brand-card border border-brand-border rounded-xl hover:border-brand-green/50 hover:bg-brand-green/5 transition-all duration-200 group"
        >
          <div class="w-10 h-10 rounded-lg bg-brand-green/10 border border-brand-green/20 flex items-center justify-center text-brand-green text-sm font-bold shrink-0 group-hover:bg-brand-green/20 transition-colors">
            {link.icon}
          </div>
          <div class="min-w-0">
            <p class="text-brand-muted text-xs">{link.label}</p>
            <p class="text-brand-text text-sm font-medium truncate">{link.value}</p>
          </div>
        </a>
      ))}
    </div>

    <!-- Main CTA -->
    <a
      href={`mailto:${profile.email}`}
      class="inline-flex items-center gap-2.5 px-8 py-4 bg-brand-green text-brand-bg font-semibold rounded-xl hover:bg-brand-green-dark transition-colors text-base"
    >
      {t.contact.cta}
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="22" y1="2" x2="11" y2="13"></line>
        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
      </svg>
    </a>
  </div>
</section>
