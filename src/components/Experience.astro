---
import SectionHeader from './ui/SectionHeader.astro';
import Tag from './ui/Tag.astro';
import { getExperience } from '../i18n/content';
import { defaultLocale, type Locale } from '../i18n/locale';
import { ui } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = ui[locale];
const experience = getExperience(locale);
---

<section id="experience" class="py-24 bg-brand-bg">
  <div class="max-w-4xl mx-auto px-6">
    <SectionHeader title={t.experience.title} subtitle={t.experience.subtitle} />

    <div class="relative mt-14">
      <!-- Vertical timeline line -->
      <div
        class="absolute left-5 top-2 bottom-2 w-px"
        style="background: linear-gradient(to bottom, #22c55e 0%, rgba(34,197,94,0.1) 100%);"
      ></div>

      <div class="space-y-10">
        {experience.map((job) => (
          <div class="relative pl-16 fade-in">
            <!-- Timeline dot -->
            <div
              class={`absolute left-3 top-3 w-5 h-5 rounded-full border-2 flex items-center justify-center ${
                job.current
                  ? "border-brand-green bg-brand-green"
                  : "border-brand-border bg-brand-card"
              }`}
            >
              {job.current && (
                <span class="absolute w-full h-full rounded-full bg-brand-green/40 animate-ping"></span>
              )}
            </div>

            <!-- Card -->
            <div class="bg-brand-card border border-brand-border rounded-xl p-6 hover:border-brand-green/40 transition-all duration-300">
              <!-- Header -->
              <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
                <div>
                  <h3 class="text-brand-text font-semibold text-lg leading-tight">
                    {job.role}
                  </h3>
                  <p class="text-brand-green font-medium mt-0.5">{job.company}</p>
                  <p class="text-brand-muted text-xs mt-0.5">{job.contractType}</p>
                </div>
                <div class="text-right shrink-0">
                  <span
                    class={`inline-block px-3 py-1 rounded-full text-xs font-medium ${
                      job.current
                        ? "bg-brand-green/10 text-brand-green border border-brand-green/30"
                        : "bg-brand-border/50 text-brand-muted border border-brand-border"
                    }`}
                  >
                    {job.period}
                  </span>
                  <p class="text-brand-muted text-xs mt-1">{job.location}</p>
                </div>
              </div>

              <!-- Description -->
              <p class="text-brand-muted text-sm leading-relaxed mb-4">
                {job.description}
              </p>

              <!-- Responsibilities -->
              <ul class="space-y-2 mb-5">
                {job.responsibilities.slice(0, 4).map((resp) => (
                  <li class="text-brand-muted text-sm flex gap-2.5">
                    <span class="text-brand-green text-xs mt-1 shrink-0">▹</span>
                    <span>{resp}</span>
                  </li>
                ))}
              </ul>

              <!-- Tech tags -->
              <div class="flex flex-wrap gap-2">
                {job.technologies.map((tech) => (
                  <Tag label={tech} />
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
