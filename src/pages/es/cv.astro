import CvPage from '../../components/CvPage.astro';
import { ui } from '../../i18n/ui';

const locale = "es";
const t = ui[locale];
---

<BaseLayout title={t.cv.metaTitle} description={t.cv.metaDescription} lang={locale}>
  <main>
    <CvPage locale={locale} />
  </main>
</BaseLayout>
